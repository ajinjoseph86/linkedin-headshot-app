# Copy this file to .env and fill in your real keys.

# fal.ai key — https://fal.ai/dashboard/keys
FAL_KEY=your_fal_api_key_here

# Port the local server runs on (Render sets this automatically in production)
PORT=3000

# Hard daily spend cap in USD. The server refuses further fal.ai calls
# once this is reached for the current day (Asia/Singapore time).
DAILY_BUDGET_USD=10.00

# Free headshots per visitor before they must buy a download to continue.
MAX_GENERATIONS_PER_CLIENT=5

# Stripe secret key — https://dashboard.stripe.com/apikeys
# Use sk_test_... while testing, sk_live_... to take real payments.
STRIPE_SECRET_KEY=

# Price per high-res download, in USD.
DOWNLOAD_PRICE_USD=2.00

# fal image quality: low | medium | high. Higher costs more per image.
IMAGE_QUALITY=low

# Only needed in production (Render persistent disk):
# DATA_DIR=/var/data
# GENERATED_DIR=/var/data/generated
